<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#14161B" BorderBrush="#262A33" BorderThickness="1"
        TextElement.Foreground="#E8EAEE" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border.Effect>
    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
  </Border.Effect>
  <Border.Resources><!--THEME--></Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Border Width="20" Height="20" CornerRadius="6" Background="#2FB36E" Margin="0,0,10,0">
          <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Передача" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="  by mysik" Foreground="#6E7584" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,4,12">
      <StackPanel Margin="16,0,12,8">

        <!-- QR -->
        <Border Background="#1C1F26" CornerRadius="16" Padding="18">
          <StackPanel>
            <Border Background="White" CornerRadius="14" Padding="10" HorizontalAlignment="Center">
              <Image x:Name="QrImage" Width="196" Height="196" RenderOptions.EdgeMode="Aliased"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
              <Ellipse x:Name="LinkDot" Width="9" Height="9" Fill="#F2B33D" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="LinkStatus" Text="Наведи камеру телефона на код" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="AddressText" Text="" Foreground="#8B92A0" FontFamily="Consolas" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,4,0,0" Cursor="Hand" ToolTip="Скопировать адрес"/>
            <WrapPanel x:Name="IpPanel" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="Телефон и компьютер должны быть в одной Wi-Fi сети. Если Windows спросит про доступ к сети — разреши для частных сетей."
                       Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <!-- на телефон -->
        <Grid Margin="4,20,0,8">
          <TextBlock Text="НА ТЕЛЕФОН" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ClipBtn" Style="{StaticResource SecondaryBtn}" Background="#1C1F26" Padding="10,6" Margin="0,0,6,0"
                    Content="Текст из буфера"/>
            <Button x:Name="AddBtn" Style="{StaticResource SecondaryBtn}" Background="#1C1F26" Padding="10,6" Content="+ Файлы"/>
          </StackPanel>
        </Grid>
        <Border x:Name="DropZone" Background="#1C1F26" CornerRadius="14" Padding="14,6" AllowDrop="True">
          <StackPanel>
            <StackPanel x:Name="SharedList"/>
            <TextBlock x:Name="SharedEmpty" Text="Перетащи сюда файлы — они сразу появятся на телефоне" Foreground="#8B92A0"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,16"/>
          </StackPanel>
        </Border>

        <!-- с телефона -->
        <Grid Margin="4,20,0,8">
          <TextBlock Text="С ТЕЛЕФОНА" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
          <Button x:Name="FolderBtn" Style="{StaticResource SecondaryBtn}" Background="Transparent" Padding="8,4"
                  HorizontalAlignment="Right" Foreground="#2FB36E" Content="Открыть папку"/>
        </Grid>
        <Border Background="#1C1F26" CornerRadius="14" Padding="14,6">
          <StackPanel>
            <StackPanel x:Name="ReceivedList"/>
            <TextBlock x:Name="ReceivedEmpty" Text="Здесь появятся фото, файлы и тексты с телефона" Foreground="#8B92A0"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,16"/>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="4,16,4,4">
          <Run Text="Передача"/>
          <Run x:Name="Signature" Text="by mysik" Foreground="#2FB36E" FontWeight="SemiBold" Cursor="Hand"/>
          <Run Text=" · работает по Wi-Fi без интернета, файлы никуда не загружаются"/>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="Snack" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,22" Padding="16,11" CornerRadius="12" Background="#2A2E38" BorderBrush="#363B47" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
      </Border.Effect>
      <TextBlock x:Name="SnackText" Text="" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#B30B0C10" Visibility="Collapsed">
      <Border Width="330" Background="#1E2128" CornerRadius="16" Padding="20" BorderBrush="#2E333E" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DlgNo" Style="{StaticResource SecondaryBtn}" Background="#2A2E38" Content="Отмена"/>
            <Button x:Name="DlgYes" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="OK"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Border>
